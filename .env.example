# Copy this file to .env and fill in your own values.
# .env is where secrets live -- never hard-code API keys in source files.

# Which backend to use: openai | huggingface | mock
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Hugging Face Inference API (alternative to OpenAI) ---
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Number of RAG-retrieved sample questions to ground generation with
RAG_TOP_K=3

# Number of questions asked per mock interview session
INTERVIEW_LENGTH=5
